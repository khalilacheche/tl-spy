# Telegram Bot API — get a token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token

# Chat ID of the group/channel to monitor (numeric ID or @username)
# For @controlestl use the numeric ID — the bot will log it on first message
TELEGRAM_CHAT_ID=

# Anthropic API — for parsing messages with Claude
ANTHROPIC_API_KEY=sk-ant-...

# Server
HOST=0.0.0.0
PORT=8000
